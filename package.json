{
  "name": "horizon-pivots",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:portal": "npm run dev --workspace=@horizon/portal",
    "dev:jobs": "npm run dev --workspace=@horizon/jobs",
    "dev:phd": "npm run dev --workspace=@horizon/phd",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspace=@horizon/portal && npm run build --workspace=@horizon/jobs && npm run build --workspace=@horizon/phd",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20"
  }
}
